# Do not fill this in by hand. From this folder, run:
#   bash ../../tools/create-local-db.sh <short-name>
# It creates the database and writes a real .env (ignored by Git) with random secrets.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=<made by the script>
PGUSER=<made by the script>
PGPASSWORD=<made by the script>
JWT_SECRET=<made by the script>
SERVICE_TOKEN=<made by the script>
# Added by hand for Module 9 (tools/local-stack.sh does this for you):
GATEWAY_URL=http://127.0.0.1:8090
GATEWAY_TOKEN=<your team's gateway token>
DEPENDENCIES=a,d
